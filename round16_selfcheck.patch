+        fr = cp.build_franken(bs, hs, 32, "retrieval")
+        m = GPT(GPTConfig(**self.KW))
+        m.load_state_dict(fr, strict=True)  # raises on any mismatch
+
+    def test_mismatched_pair_rejected(self):
